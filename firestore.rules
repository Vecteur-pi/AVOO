rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function authEmailLower() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : "";
    }

    function memberPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/members/$(request.auth.uid);
    }

    function isActiveMember(restaurantId) {
      return signedIn()
        && exists(memberPath(restaurantId))
        && get(memberPath(restaurantId)).data.active == true;
    }

    function memberRole(restaurantId) {
      return get(memberPath(restaurantId)).data.role;
    }

    // Fallback: check admin status via global users/{uid} doc
    // Needed when owner's member doc is at an auto-generated ID instead of their UID
    function isAdminByUserDoc(restaurantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurant_id == restaurantId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restaurantId == restaurantId
        )
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in [
          "owner", "admin", "manager", "owner_manager",
          "gerant", "gérant", "proprietaire", "propriétaire"
        ];
    }

    function isOwner(restaurantId) {
      return (
        isActiveMember(restaurantId)
        && (memberRole(restaurantId) in [
          "owner", "admin", "manager", "owner_manager",
          "gerant", "gérant", "proprietaire", "propriétaire"
        ])
      ) || isAdminByUserDoc(restaurantId);
    }

    function isStaffAdmin(restaurantId) {
      return (
        isActiveMember(restaurantId)
        && (memberRole(restaurantId) in [
          "owner", "admin", "manager", "owner_manager",
          "gerant", "gérant", "proprietaire", "propriétaire"
        ])
      ) || isAdminByUserDoc(restaurantId);
    }

    function isStaff(restaurantId) {
      return isActiveMember(restaurantId)
        && (memberRole(restaurantId) in ["owner", "waiter", "serveur", "server", "service"]);
    }

    function normalizedRole(role) {
      return role is string ? role.lower() : "";
    }

    function isLockedOwnerRole(role) {
      return normalizedRole(role) in ["owner", "owner_manager", "owner-manager", "proprietaire", "propriétaire"];
    }

    // Bootstrap create from registration flow
    function isRestaurantBootstrapCreate(restaurantId) {
      return signedIn()
        && request.resource.data.id == restaurantId
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
    }

    function isOwnerSeedMember(restaurantId, uid) {
      return isSelf(uid)
        && request.resource.data.role == "owner"
        && request.resource.data.active == true
        && (
          request.resource.data.restaurant_id == restaurantId
          || request.resource.data.restaurantId == restaurantId
        );
    }

    function invitationPath(restaurantId, invitationId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/staff_invitations/$(invitationId);
    }

    function emailMatchesCurrentUser(email, emailLower) {
      return signedIn()
        && (
          (emailLower is string && emailLower == authEmailLower())
          || (email is string && email.lower() == authEmailLower())
        );
    }

    function hasValidInvitationForSelf(restaurantId, invitationId) {
      return signedIn()
        && invitationId is string
        && invitationId.size() > 0
        && exists(invitationPath(restaurantId, invitationId))
        && get(invitationPath(restaurantId, invitationId)).data.status == "pending"
        && emailMatchesCurrentUser(
          get(invitationPath(restaurantId, invitationId)).data.email,
          get(invitationPath(restaurantId, invitationId)).data.email_lower
        )
        && (
          !(get(invitationPath(restaurantId, invitationId)).data.expires_at is timestamp)
          || get(invitationPath(restaurantId, invitationId)).data.expires_at > request.time
        )
        && (
          !(get(invitationPath(restaurantId, invitationId)).data.expiresAt is timestamp)
          || get(invitationPath(restaurantId, invitationId)).data.expiresAt > request.time
        );
    }

    // ---- Default deny ----
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Top-level user mapping ----
    match /users/{uid} {
      allow read: if isSelf(uid)
        || (
          signedIn()
          && (
            isOwner(resource.data.restaurant_id)
            || isOwner(resource.data.restaurantId)
          )
        );

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.active == true
        && request.resource.data.restaurant_id is string
        && (
          request.resource.data.role == "owner"
          || hasValidInvitationForSelf(
            request.resource.data.restaurant_id,
            request.resource.data.invitation_id
          )
          || hasValidInvitationForSelf(
            request.resource.data.restaurant_id,
            request.resource.data.invitationId
          )
        );

      allow update: if isSelf(uid)
        || (
          (
            isOwner(resource.data.restaurant_id)
            || isOwner(resource.data.restaurantId)
          )
          && !isLockedOwnerRole(resource.data.role)
          && !isLockedOwnerRole(request.resource.data.role)
        );

      allow delete: if (
        isOwner(resource.data.restaurant_id)
        || isOwner(resource.data.restaurantId)
      )
        && !isLockedOwnerRole(resource.data.role);
    }

    // ---- Restaurants ----
    match /restaurants/{restaurantId} {

      // restaurant doc
      allow read: if isActiveMember(restaurantId);
      allow update, delete: if isOwner(restaurantId);
      allow create: if isRestaurantBootstrapCreate(restaurantId);

      // Areas
      match /areas/{areaId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update, delete: if isOwner(restaurantId);
      }

      // Members
      match /members/{uid} {
        allow read: if isActiveMember(restaurantId);

          allow create: if (
              isStaffAdmin(restaurantId)
              && !isLockedOwnerRole(request.resource.data.role)
            )
            || isOwnerSeedMember(restaurantId, uid)
            || (
              signedIn()
              && uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.active == true
              && (
                request.resource.data.restaurant_id == restaurantId
                || request.resource.data.restaurantId == restaurantId
              )
              && emailMatchesCurrentUser(
                request.resource.data.email,
                request.resource.data.email_lower
              )
              && (
                hasValidInvitationForSelf(
                  restaurantId,
                  request.resource.data.invitation_id
                )
                || hasValidInvitationForSelf(
                  restaurantId,
                  request.resource.data.invitationId
                )
              )
            );
          // Allow joining members to overwrite the stub document with their full data
          allow update: if (
              isStaffAdmin(restaurantId)
              && !isLockedOwnerRole(resource.data.role)
              && !isLockedOwnerRole(request.resource.data.role)
            )
            || (
              signedIn()
              && uid == request.auth.uid
              && (
                request.resource.data.restaurant_id == restaurantId
                || request.resource.data.restaurantId == restaurantId
              )
              && request.resource.data.active == true
              && emailMatchesCurrentUser(
                request.resource.data.email,
                request.resource.data.email_lower
              )
              && (
                hasValidInvitationForSelf(
                  restaurantId,
                  request.resource.data.invitation_id
                )
                || hasValidInvitationForSelf(
                  restaurantId,
                  request.resource.data.invitationId
                )
              )
            );
        allow delete: if isStaffAdmin(restaurantId)
          && !isLockedOwnerRole(resource.data.role);
      }

      // Staff invitations (Spark-friendly manual email flow)
      match /staff_invitations/{inviteId} {
        allow read: if isStaffAdmin(restaurantId)
          || emailMatchesCurrentUser(resource.data.email, resource.data.email_lower);

        allow create, delete: if isStaffAdmin(restaurantId);

        allow update: if isStaffAdmin(restaurantId)
          || (
            signedIn()
            && resource.data.status == "pending"
            && emailMatchesCurrentUser(resource.data.email, resource.data.email_lower)
            && request.resource.data.status == "accepted"
            && (
              request.resource.data.accepted_by == request.auth.uid
              || request.resource.data.acceptedBy == request.auth.uid
            )
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  "status",
                  "accepted_at",
                  "acceptedAt",
                  "accepted_by",
                  "acceptedBy",
                  "updated_at",
                  "updatedAt"
                ])
          );
      }

      // Settings
      match /settings/{settingsId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update, delete: if isOwner(restaurantId);
      }

      // Tables
      match /tables/{tableId} {
        allow read: if isActiveMember(restaurantId);
        allow create, delete: if isOwner(restaurantId);

        allow update: if isOwner(restaurantId)
          || (
            isStaff(restaurantId)
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  "active_ticket_id",
                  "active_ticket_status",
                  "qr_token_id",
                  "status",
                  "updated_at"
                ])
          );
      }

      // Users under restaurant (optional)
      match /users/{uid} {
        allow read: if isOwner(restaurantId) || isSelf(uid);

        allow create: if isOwner(restaurantId)
          || isOwnerSeedMember(restaurantId, uid)
          || (
            signedIn()
            && uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.active == true
            && (
              request.resource.data.restaurant_id == restaurantId
              || request.resource.data.restaurantId == restaurantId
            )
            && emailMatchesCurrentUser(
              request.resource.data.email,
              request.resource.data.email_lower
            )
            && (
              hasValidInvitationForSelf(
                restaurantId,
                request.resource.data.invitation_id
              )
              || hasValidInvitationForSelf(
                restaurantId,
                request.resource.data.invitationId
              )
            )
          );
          
        allow update: if (
              isStaffAdmin(restaurantId)
              && !isLockedOwnerRole(resource.data.role)
              && !isLockedOwnerRole(request.resource.data.role)
            )
          || (
            signedIn()
            && uid == request.auth.uid
            && (
              request.resource.data.restaurant_id == restaurantId
              || request.resource.data.restaurantId == restaurantId
            )
            && request.resource.data.active == true
            && emailMatchesCurrentUser(
              request.resource.data.email,
              request.resource.data.email_lower
            )
            && (
              hasValidInvitationForSelf(
                restaurantId,
                request.resource.data.invitation_id
              )
              || hasValidInvitationForSelf(
                restaurantId,
                request.resource.data.invitationId
              )
            )
          );
        allow delete: if isOwner(restaurantId)
          && !isLockedOwnerRole(resource.data.role);
      }

      // Menu
      match /menu_categories/{catId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update, delete: if isOwner(restaurantId);
      }

      match /menu_items/{itemId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update, delete: if isOwner(restaurantId);
      }

      // Tickets
      match /tickets/{ticketId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update: if isStaff(restaurantId);
        allow delete: if isOwner(restaurantId);

        match /items/{itemId} {
          allow read: if isActiveMember(restaurantId);
          allow create, update: if isStaff(restaurantId);
          allow delete: if isOwner(restaurantId);
        }
      }

      // Incidents
      match /incidents/{incidentId} {
        allow read: if isActiveMember(restaurantId);
        allow create: if isStaff(restaurantId);
        allow update, delete: if isOwner(restaurantId);
      }

      // Inventory (Stocks)
      match /inventory/{itemId} {
        allow read: if isActiveMember(restaurantId);
        allow create, update: if isStaffAdmin(restaurantId);
        allow delete: if isOwner(restaurantId);
      }
    }

    // ---- ORDERS (New) ----
    match /orders/{orderId} {
      // Allow read if user is a member of the restaurant
      allow read: if isActiveMember(resource.data.restaurantId);
      
      // Allow create if user is a member of the restaurant (e.g. staff creating order)
      allow create: if isActiveMember(request.resource.data.restaurantId);
      
      // Allow update if user is a member (e.g. changing status)
      allow update: if isActiveMember(resource.data.restaurantId);
      
      // Allow delete if user is owner
      allow delete: if isOwner(resource.data.restaurantId);
    }

    // ---- SALES HOURLY (Dashboard chart) ----
    match /salesHourly/{dayId} {
      // If the doc is scoped by restaurant, enforce membership.
      // If not scoped, allow authenticated users to read.
      allow read: if signedIn()
        && (
          resource == null
          ||
          (resource.data.restaurantId is string
            && isActiveMember(resource.data.restaurantId))
          || (resource.data.restaurant_id is string
            && isActiveMember(resource.data.restaurant_id))
          || (
            !(resource.data.restaurantId is string)
            && !(resource.data.restaurant_id is string)
          )
        );

      // Writes should stay server-side/admin controlled.
      allow create, update, delete: if false;
    }
  }
}
